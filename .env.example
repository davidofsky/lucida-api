# lucida-api configuration
# Every value is optional — the defaults below are what the code applies if unset.
# Copy to `.env` and adjust as needed.

# Runtime environment: development | production
NODE_ENV=development

# HTTP port the server listens on.
PORT=3000

# Interface to bind. Defaults to loopback; Docker needs 0.0.0.0 to be reachable
# from outside the container (the Dockerfile and compose file set it).
HOST=127.0.0.1

# Where the challenge solver listens. Compose points this at its own byparr
# service; running outside Docker, start byparr yourself and leave this as is.
SOLVER_URL=http://127.0.0.1:8191

# How long the solver may spend clearing the challenge before giving up.
CLEARANCE_TIMEOUT_MS=60000

# Escape hatch: set BOTH to skip the solver entirely and use a cookie you supply
# yourself. The user agent must be the one the cookie was issued to, or
# Cloudflare rejects it.
# CF_CLEARANCE=
# USER_AGENT=
