# lucida-api configuration
# Every value is optional — the defaults below are what the code applies if unset.
# Copy to `.env` and adjust as needed.

# Runtime environment: development | production
NODE_ENV=development

# HTTP port the server listens on.
PORT=3000

# Interface to bind. Defaults to loopback; Docker needs 0.0.0.0 to be reachable
# from outside the container (the Dockerfile and compose file set it).
HOST=127.0.0.1

# How long to wait for lucida's Cloudflare challenge to hand back a cf_clearance
# cookie before giving up at boot. Raise it if the solve is slow on your host.
CLEARANCE_TIMEOUT_MS=60000

# Launch Chromium with --no-sandbox and --disable-dev-shm-usage (needed inside
# Docker; docker-compose sets this). Any non-empty value enables it.
# CHROME_NO_SANDBOX=true

# Escape hatch: set BOTH to skip the browser entirely and use a cookie you pasted
# in by hand. The user agent must be the one the cookie was issued to, or
# Cloudflare rejects it.
# CF_CLEARANCE=
# USER_AGENT=
